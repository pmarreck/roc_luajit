#!/usr/bin/env bash
# Run the whole suite: upstream MiniCI (the native oracle's own tests) and
# the LuaJIT backend suite. Exit status accumulates every failure.
set -u

root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$root/luajit_backend/scripts/zig_cpu_cap.bash"

usage() {
	cat <<'USAGE'
Usage: ./test-all [--luajit-only] [--dry-run]

  (default)       upstream MiniCI, then luajit_backend/tests/run
  --luajit-only   only the LuaJIT backend suite
  --dry-run       print the commands instead of running them

Environment:
  ROC_LUAJIT_ZIG_CPUS  CPUs Zig may use (default 32, clamped to the host).
USAGE
}

luajit_only=0
dry_run=0
while [ $# -gt 0 ]; do
	case "$1" in
		--luajit-only) luajit_only=1 ;;
		--dry-run) dry_run=1 ;;
		-h | --help) usage; exit 0 ;;
		*) echo "error: unknown option '$1' (see ./test-all --help)" >&2; exit 2 ;;
	esac
	shift
done

cpus="$(zig_cpu_list)" || exit 2
cd "$root" || exit 1
failures=0
if [ "$luajit_only" -eq 0 ]; then
	run_or_print "MINICI_MAX_CPUS=8 nix develop -c taskset -c $cpus zig build minici" || failures=$((failures + 1))
fi
run_or_print "nix develop -c luajit_backend/tests/run" || failures=$((failures + 1))
exit "$failures"
