#!/usr/bin/env bash
# Run this package's backend suite. Compiler-library tests live upstream.
set -eu
root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
dry_run=0
suite=run
while [ $# -gt 0 ]; do
    case "$1" in
        --portable) suite=portable ;;
        --luajit-only) suite=run ;;
        --dry-run) dry_run=1 ;;
        -h|--help) echo 'Usage: ./test-all [--portable|--luajit-only] [--dry-run]'; exit 0 ;;
        *) echo "Unknown option: $1" >&2; exit 2 ;;
    esac
    shift
done
cd "$root"
command=(nix develop -c "luajit_backend/tests/$suite")
if [ "$dry_run" -eq 1 ]; then printf '%q ' "${command[@]}"; printf '\n'; else exec "${command[@]}"; fi
