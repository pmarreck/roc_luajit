# Dirtree: Stateful directory trees in the CLI for humans and LLMs. https://github.com/pmarreck/dirtree
ver=1.2
annotate=[
	ARCHITECTURE.md = M0 code-cited map of Roc LIR, ARC, layouts, platform ABI and the LuaJIT differential oracle design
	bm = fixed-workload and startup gates (performance-profile --mode bm)
	build = Builds roc via nix under the Zig CPU cap (ReleaseFast default; --debug, --test)
	cg = input-growth gates (performance-profile --mode cg)
	luajit_backend/README.md = Quickstart: build roc, compile a basic-cli app to Lua, run it under LuaJIT; current gaps
	luajit_backend/bench = Benchmark Roc programs for ./bm (complexity and scale headers)
	luajit_backend/bench/compare/ex = Elixir script ports of the ./bm programs for bench/compare/run
	luajit_backend/bench/compare/py = Python ports of the ./bm programs (CPython and PyPy) for bench/compare/run
	luajit_backend/bench/compare/rb = Ruby ports of the ./bm programs (run with --yjit) for bench/compare/run
	luajit_backend/bench/compare/results = Per-host markdown tables from bench/compare/run
	luajit_backend/bench/compare/run = Runs ./bm programs vs CPython/PyPy/Ruby YJIT/Elixir ports; checks outputs vs native Roc; hyperfine at K and 4K; writes results/<host>.md
	luajit_backend/bench/measure = Median user instructions (perf), wall time and peak RSS (GNU time) of a command over N runs
	luajit_backend/bench/profile/adapter.lua = performance-profile adapter core: loads a generated program as a factory, measures verified runs in-process (time or GC memory)
	luajit_backend/bench/profile/driver.lua = performance-profile driver: native-output oracle, real clocks and GC, protocol JSON
	luajit_backend/bench/profile/engine = runs performance-profile with this project's config, LuaJIT and history URL
	luajit_backend/bench/profile/run = performance-profile adapter command: builds a bench program (cached) and runs the driver
	luajit_backend/bench/ratios.lua = ./bm growth classifier: repeated-median fitted per-doubling ratio, complexity gates, change vs previous run (pure; CLI emits JSON)
	luajit_backend/demos/basic-cli = Vendored basic-cli 0.23.0 examples, fixtures and test spec (UPL-1.0)
	luajit_backend/demos/exercism = Vendored Exercism Roc track (tests + .meta solutions, MIT) for exercism_conformance
	luajit_backend/demos/roc-lang-examples/expect_scripts = Upstream expect scripts (aec3a4f, CC0) for 13 vendored demos
	luajit_backend/platforms/lua = Lua platform: Roc apps run LuaJIT code (Lua.eval!) natively or on --target=luajit; one byte-RPC hosted call, shared host.lua
	luajit_backend/platforms/lua/Lua.roc = Lua.Value, Lua.eval!, the Roc-side LuaValue byte codec and host-call helpers
	luajit_backend/platforms/lua/build-host = Builds targets/x64musl/libhost.a: host.zig + roc builtins via zig build-lib, merged with static musl LuaJIT
	luajit_backend/platforms/lua/host.lua = Lua platform core for both hosts: LuaValue codec, ops (eval, stdio, env, files), real ports, and the LuaJIT host's run()
	luajit_backend/platforms/lua/host.zig = Lua platform native host: embeds LuaJIT + host.lua, forwards Host.call! bytes to dispatch
	luajit_backend/platforms/wasi_basic_cli/README.md = How to build and run basic-cli apps on WASI; what works and what WASI cannot provide
	luajit_backend/platforms/wasi_basic_cli/build = Builds the WASI copy of basic-cli 0.23 (wasm32 target, ZigGlue, host.wasm, generated stubs)
	luajit_backend/platforms/wasi_basic_cli/host.zig = WASI host for basic-cli 0.23: hosted functions on wasi_snapshot_preview1, POSIX-over-preopens layer
	luajit_backend/probes/lir = M0 Roc programs whose LIR (ROC_LIR_DUMP) shows static data and uniqueness-check sites
	luajit_backend/probes/lir/i128_mul_overflow.roc = Repro for Zig 0.16 Debug @mulWithOverflow(i128) misreport
	luajit_backend/probes/uniqueness_policy.lua = M0 probe: List.append growth under counted vs never-unique RC policies on LuaJIT
	luajit_backend/scripts/expects_to_app.lua = Turns a file of top-level expects into an app printing each result
	luajit_backend/scripts/helper_server = LuaJIT ports of basic-cli's test servers: tcp echo :8085, http :9000 (+ /x/ routes), dns black hole :53
	luajit_backend/scripts/netns_run = Run a command in a private network namespace (own loopback, caller's ids); --private-dns adds a private resolver setup
	luajit_backend/scripts/pty_run = Run a command on a pseudo-terminal, typing input as basic-cli's test.py pty_process does
	luajit_backend/scripts/tail_calls.lua = Lints runtime tail calls: bytecode-resolved callees; single-valued ones must be return (f(...))
	luajit_backend/scripts/with_helper = Start a helper_server, wait for its port, run a command, stop the helper
	luajit_backend/scripts/zig_cpu_cap.bash = Shared helper: Zig CPU-affinity list (default 16, ROC_LUAJIT_ZIG_CPUS) and dry-run runner
	luajit_backend/tests/alloc_budget = Bytes allocated per op (GC stopped) for bench programs vs ceilings; deterministic perf gate
	luajit_backend/tests/apps/branchy_loop.roc = Loop with branching body; whole body must be inside the while block
	luajit_backend/tests/apps/checked_arith.roc = Checked add/sub across 2^53 and 8/32-bit bounds (inline fast path), native vs LuaJIT
	luajit_backend/tests/apps/from_le_bytes.roc = Integer.from_le_bytes for all widths at boundaries (echo app)
	luajit_backend/tests/apps/int64_boundary.roc = I64/U64 around 2^53 (number vs cdata forms) in emitted code
	luajit_backend/tests/apps/list_header_aliasing.roc = Lists kept vs derived/shared (aliasing guard for in-place list headers)
	luajit_backend/tests/apps/long_chain.roc = 240-step dependent chain; frame-slot coalescing fixture
	luajit_backend/tests/apps/merges.roc = Loop-free branches and merges; forward-goto layout fixture
	luajit_backend/tests/apps/record_lists.roc = Every list op on record/tuple/tag/nested elements, shared and unique (flat list storage coverage, emitted_layout check 10)
	luajit_backend/tests/apps/static_box_of_zst.roc = Constant recursive value with a Box({}) leaf (static box_of_zst)
	luajit_backend/tests/apps/tail_loop.roc = Tail-recursive loop; must form a LuaJIT loop trace
	luajit_backend/tests/apps/uses_sin.roc = Calls F64.sin: only fmath may be compiled lazily (emitted_layout check 5)
	luajit_backend/tests/apps/wide_tag_sites.roc = Thirty-variant tag materialized at many sites (emitted_layout check 6)
	luajit_backend/tests/basic_cli_cases.lua = Runs basic-cli's test_spec.json cases: native vs LuaJIT plus upstream assertions
	luajit_backend/tests/basic_cli_conformance = Builds basic-cli apps natively and for LuaJIT (offline packages), then runs basic_cli_cases.lua
	luajit_backend/tests/basic_cli_extra = Own basic-cli apps + fixtures in upstream test_spec.json format; run by basic_cli_conformance, all must agree
	luajit_backend/tests/basic_cli_extra/apps/cmd_ops.roc = Cmd/Child processes edge cases (exit, signal, limits, timeouts, merge, tee, interactive), native vs LuaJIT
	luajit_backend/tests/basic_cli_extra/apps/path_copy_mode.roc = Path.copy! keeps permission bits (split from path_ops; a WASI limit)
	luajit_backend/tests/basic_cli_extra/apps/path_ops.roc = Path copy/copy_dir/absolute/canonicalize and temp dir edge cases, native vs LuaJIT
	luajit_backend/tests/basic_cli_extra/apps/resource_drop.roc = Freeing the last Child reference kills it (box drop hook), native vs LuaJIT
	luajit_backend/tests/basic_cli_extra/apps/sqlite_ops.roc = SQLite values, bindings, errors, memory/file DBs, native vs LuaJIT
	luajit_backend/tests/basic_cli_extra/apps/tcp_ops.roc = TCP listener+stream over loopback (deadlines, reads, errors, close), native vs LuaJIT
	luajit_backend/tests/basic_cli_wasi_unsupported_ratchet = Unsupported-case ratchet (upstream extra) for basic-cli on WASI
	luajit_backend/tests/bm_ratios.lua = Tests ratios.lua as a classifier over timing cases (linear, quadratic, outliers, history changes)
	luajit_backend/tests/cli/wrappers.bash = CLI tests for ./build and ./test-all dry-run commands and CPU cap validation
	luajit_backend/tests/demo_expect = Runs roc-lang/examples' own expect scripts against LuaJIT builds of the demos
	luajit_backend/tests/echo_conformance = Builds test/echo apps natively and for LuaJIT; compares stdout/stderr/exit
	luajit_backend/tests/emitted_layout = Checks emitted Lua shape: frame slots, forward segment layout, traced loops
	luajit_backend/tests/exercism_conformance = Generates apps from exercism expects and runs them native vs LuaJIT
	luajit_backend/tests/fake_roc_wrong_output = Fake roc for demo_expect's negative control: programs print the wrong text
	luajit_backend/tests/fx_conformance = Runs every fx IO spec against native and LuaJIT builds; compares stdout/stderr/exit
	luajit_backend/tests/fx_host_flags = fx host flags (self-test, unknown) under LuaJIT vs native host.zig, differential
	luajit_backend/tests/fx_specs.lua = Extracts fx IO specs from fx_test_specs.zig as NUL-terminated records
	luajit_backend/tests/helper_servers = Tests scripts/helper_server routes, keep-alive, pipelining, echo, dns, with_helper
	luajit_backend/tests/list_flat.lua = Flat (k-stride) list storage: template expander output and a seeded differential of every list op vs one-table-per-element lists
	luajit_backend/tests/lua_platform_conformance = Builds each Lua platform app natively and for LuaJIT; outputs and exit statuses must agree
	luajit_backend/tests/lua_platform_core.lua = Lua platform core tests: codec round trips, canonicalization, rejections, ops via recording adapters
	luajit_backend/tests/netns_run = Tests scripts/netns_run (namespace, ids, loopback, --private-dns)
	luajit_backend/tests/numeric_vectors.lua = Replays luajit-numeric-vectors output against the runtime helpers the emitter calls (all int widths, Dec)
	luajit_backend/tests/profile_adapter.lua = tests the profile adapter core with injected clocks and GC
	luajit_backend/tests/pty_run = Tests scripts/pty_run (terminal streams, raw input, timeout)
	luajit_backend/tests/run = LuaJIT backend suite runner; exit code = failing scripts
	luajit_backend/tests/runtime_integers.lua = Runtime integer semantics: exhaustive U8/I8 pairs and 32/64-bit boundary vectors
	luajit_backend/tests/runtime_strings.lua = Str view property test: random concat histories vs plain Lua strings
	luajit_backend/tests/tail_calls_cycle = Fixture test: scripts/tail_calls.lua decides mutually tail-calling functions together
	luajit_backend/tests/toolchain.lua = Bootstrap LuaJIT 2.1/FFI/bit smoke used by the flake toolchain check
	luajit_backend/tests/unsupported_ratchet = Max unsupported eval cases allowed by the differential run; lower as coverage grows
	luajit_backend/upstream_reports/README.md = Candidate upstream reports (Roc panics, dev-backend segfault, Zig SEGV); local notes, not filed
	luajit_backend/upstream_reports/reproduce = Rebuild every upstream-report candidate and print each failure
	luajit_backend/upstream_reports/set_fold_speed_abi_crash.roc = Native --opt=speed aborts in x86_64 SysV classify on a Set fold over a list (repro)
	mg = memory growth and cleanup gates (performance-profile --mode mg)
	profiling.json = performance-profile cases: cg/mg/bm per bench program, startup
	src/backend/lua/LuaEmitter.zig = Pure LIR-to-LuaJIT emitter; refuses unsupported constructs by name
	src/backend/lua/LuaHost.zig = Assembles runnable Lua programs: platform host around the platform-mode emitter chunk
	src/backend/lua/crypto.lua = SHA-256 and BLAKE3: port of builtins/crypto.zig incl. serialized incremental hasher states
	src/backend/lua/float.lua = F32/F64: binary32 rounding, NaN-safe bit access, Roc float formatting (exact Ryu equivalent) and exact int/Dec/float conversions
	src/backend/lua/fmath.lua = F32/F64 transcendentals: bit-exact LuaJIT port of builtins/float_math (trig, rem_pio2, asin/acos/atan, atan2, pow, f32 log)
	src/backend/lua/hosts/basic_cli_0_23_0.lua = Bundled LuaJIT host for basic-cli 0.23.0 (port of its Rust host)
	src/backend/lua/hosts/default.lua = LuaJIT host for Roc's default (headerless-app) platform, mirrors linux_runtime.zig
	src/backend/lua/int128.lua = I128/U128/Dec ops over wide.lua, ported bit-for-bit from src/builtins/dec.zig
	src/backend/lua/list.lua = Roc List runtime: port of builtins/list.zig (capacity, seamless slices, uniqueness) plus LIR low-level entry points
	src/backend/lua/numparse.lua = Int/Dec/float token grammars and exact parse values (ports of num.zig, decimal_parse.zig, parse_float acceptance)
	src/backend/lua/runtime.lua = Lua runtime embedded in emitted programs: crash protocol, RC helpers, exact ints
	src/backend/lua/simd.lua = 128-bit integer SIMD: lane-for-lane LuaJIT port of builtins/simd.zig over an immutable FFI roc_v128 union
	src/backend/lua/sort.lua = Fluxsort/quadsort port of builtins/sort.zig for List.sort_with: same comparison sequence, flat-table pointers
	src/backend/lua/test/numeric_vectors.zig = Generates reference vectors for int128.lua from upstream RocDec builtins (built ReleaseSafe)
	src/backend/lua/wide.lua = Exact unsigned integers as 16-bit limb arrays (add, mul, divmod, decimal I/O) for the Lua runtime
	src/eval/test/luajit_differential_runner.zig = Differential runner: LIR interpreter oracle vs emitted Lua in a luajit process
	test-all = Runs upstream MiniCI plus luajit_backend/tests/run under the Zig CPU cap
	test/fx/platform/host.lua = LuaJIT host for the fx test platform: port of host.zig incl. --test IO-spec mode
]
