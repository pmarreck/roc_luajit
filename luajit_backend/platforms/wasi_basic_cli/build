#!/usr/bin/env bash
# Builds a WASI copy of basic-cli 0.23.0 in OUT_DIR: basic-cli's platform
# sources (from $ROC_LUAJIT_BASIC_CLI_0_23_0, set by the project flake) with a
# wasm32 target added, whose host (targets/wasm32/host.wasm) is host.zig built
# for wasm32-wasi against glue generated from that same platform. An app keeps
# its ordinary basic-cli header and builds with
#   roc build --target=wasm32 --replace-dep <basic-cli URL> OUT_DIR/main.roc ...
# and the result runs under a WASI runtime (wasmtime).
#
# Usage: build OUT_DIR [ROC]
set -u
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$here/../../.." && pwd)"
out="${1:?usage: build OUT_DIR [ROC]}"
roc="${2:-${ROC_LUAJIT_NATIVE_ROC:-$root/zig-out/bin/roc-native}}"
basic_cli="${ROC_LUAJIT_BASIC_CLI_0_23_0:?set by the project flake (nix develop)}"
http_pkg="${ROC_LUAJIT_ROC_HTTP_1_0_0:?set by the project flake (nix develop)}"

mkdir -p "$out/targets/wasm32" "$out/glue" || exit 1
for f in "$basic_cli"/*.roc "$basic_cli"/*.md; do
	[ -f "$f" ] && install -m 644 "$f" "$out/" || exit 1
done
# The http package basic-cli depends on is copied beside the platform and
# referenced by path, so the platform names no URL: building it (in a Nix
# sandbox, say) and building apps against it never need the network.
rm -rf "$out/http" && cp -R "$http_pkg" "$out/http" && chmod -R u+w "$out/http" || exit 1
# The wasm32 target: the host object plus the app, exporting the WASI
# command entry point.
awk '
	/^\t\thttp: "https:\/\// { print "\t\thttp: \"http/main.roc\","; next }
	{ print }
	/^\t\tarm64musl: \{ inputs:/ { print "\t\twasm32: { inputs: [\"host.wasm\", app], exports: [\"_start\"] }," }
' "$basic_cli/main.roc" >"$out/main.roc" || exit 1
grep -q 'wasm32: { inputs: \["host.wasm", app\]' "$out/main.roc" || { echo "build: could not add the wasm32 target" >&2; exit 1; }
grep -q '^		http: "http/main.roc",' "$out/main.roc" || { echo "build: could not point http at the local copy" >&2; exit 1; }

"$roc" glue "$root/zig-out/test-data/ZigGlue.roc" "$out/glue" "$out/main.roc" >"$out/glue/glue.log" 2>&1 \
	|| { cat "$out/glue/glue.log" >&2; exit 1; }

# Every hosted function host.zig does not implement gets a stub with the
# glue's exact signature that reports it and exits, instead of the trap that
# an undefined weak symbol links to. The stubs live in a copy of the glue,
# where the signature's type names resolve.
implemented="$(grep -o 'export fn hosted_[a-z0-9_]*' "$here/host.zig" | sed 's/export fn //' | sort -u)"
{
	cat "$out/glue/roc_platform_abi.zig"
	printf '\n// Generated by luajit_backend/platforms/wasi_basic_cli/build: hosted\n'
	printf '// functions the WASI host does not provide.\n'
	printf 'extern fn roc_wasi_unsupported(name: [*]const u8, len: usize) noreturn;\n'
	sed -n 's/^pub extern fn \(hosted_[a-z0-9_]*\)(\(.*\)) callconv(\.c) \(.*\);$/\1|\2|\3/p' "$out/glue/roc_platform_abi.zig" |
		while IFS='|' read -r name params ret; do
			printf '%s\n' "$implemented" | grep -qx "$name" && continue
			params="$(printf '%s' "$params" | sed 's/arg[0-9]*: /_: /g')"
			printf 'fn stub_%s(%s) callconv(.c) %s {\n\troc_wasi_unsupported("%s", %d);\n}\n' "$name" "$params" "$ret" "$name" "${#name}"
			printf 'comptime {\n\t@export(&stub_%s, .{ .name = "%s" });\n}\n' "$name" "$name"
		done
} >"$out/glue/abi_with_stubs.zig" || exit 1

(cd "$root" && zig build wasi-platform-host -Dwasi-abi="$out/glue/abi_with_stubs.zig" -j2) || exit 1
cp "$root/zig-out/wasi-host.wasm" "$out/targets/wasm32/host.wasm" || exit 1
echo "built $out (wasm32 host $(wc -c <"$out/targets/wasm32/host.wasm") bytes)"
