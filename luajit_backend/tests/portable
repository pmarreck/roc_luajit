#!/usr/bin/env bash
# Runtime and compiler-driver checks that do not require Linux native hosts.
set -eu
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$here/../.." && pwd)"
cd "$root"
zig build roc test build-test-luajit-differential -j2
zig fmt --check build.zig src
for test in toolchain runtime_integers runtime_strings list_flat lua_platform_core profile_adapter; do
    luajit "$here/$test.lua"
done
bash "$here/cli/wrappers.bash"
bash "$here/cli/driver.bash"
bash "$here/numeric_vectors_parallel"
bash "$here/emitted_layout"
luajit "$root/luajit_backend/scripts/tail_calls.lua" "$root/src/backend/lua" --check
bash "$here/tail_calls_cycle"
runner="$root/zig-out/bin/luajit-differential-runner"
"$runner" --threads "${ROC_LUAJIT_DIFF_THREADS:-2}" --timeout 240000 "max-unsupported=$(cat "$here/unsupported_ratchet")"
"$runner" --threads 1 --filter 'typed simple lambda increment' mutate=int-literals expect-divergence
"$runner" --threads 1 --filter 'decimal addition' mutate=dec-literals expect-divergence
