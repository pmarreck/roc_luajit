#!/usr/bin/env bash
# roc-lang/examples' own expected outputs, checked against the LuaJIT builds:
# each demo with an expect script in luajit_backend/demos/roc-lang-examples/
# expect_scripts/ (upstream's ci_scripts/expect_scripts, unchanged) is built
# with --target=luajit, ./examples/<Name>/main becomes a wrapper that runs
# it under luajit, and upstream's script runs as in its CI. This oracle is
# independent of the native build that demo_conformance compares against.
#
# Usage: demo_expect [ROC]
# Exit status: the number of failing demos.
set -u

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$here/../.." && pwd)"
roc="${1:-$root/zig-out/bin/roc}"
demos="$root/luajit_backend/demos/roc-lang-examples"
work="$(mktemp -d "${TMPDIR:-/tmp}/demo_expect.XXXXXX")"
trap 'rm -rf "$work"' EXIT
mkdir -p "$work/ci_scripts"
cp -r "$demos/expect_scripts" "$work/ci_scripts/expect_scripts"

failures=0 passed=0
while IFS= read -r entry; do
	name="${entry%%/*}"
	script="$work/ci_scripts/expect_scripts/$name.exp"
	[ -f "$script" ] || continue
	dir="$work/examples/$name"
	mkdir -p "$dir"
	if ! "$roc" build --target=luajit --no-cache "$demos/$entry" --output="$dir/app.lua" >"$dir/build.log" 2>&1; then
		echo "  FAIL $name: LuaJIT build failed"
		sed 's/^/    /' "$dir/build.log" | head -5
		failures=$((failures + 1))
		continue
	fi
	printf '#!/usr/bin/env bash\nexec luajit "$(dirname "$0")/app.lua" "$@"\n' >"$dir/main"
	chmod +x "$dir/main"
	if (cd "$work" && timeout 60 expect "ci_scripts/expect_scripts/$name.exp" >"$dir/expect.log" 2>&1); then
		passed=$((passed + 1))
	else
		echo "  FAIL $name: upstream's expect script rejected the output"
		tail -5 "$dir/expect.log" | sed 's/^/    /'
		failures=$((failures + 1))
	fi
done < <(grep -v '^#' "$demos/MANIFEST")

echo "demo_expect: $passed passed, $failures failed"
exit "$failures"
