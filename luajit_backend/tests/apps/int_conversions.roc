# Every integer conversion between kinds of at most 64 bits (to_X and
# to_X_wrap), over each source kind's boundary values: the LuaJIT backend
# lowers lossless ones to plain moves and the rest to per-pair runtime
# functions. Generated from Builtin.roc's signatures; the values pass
# through List.map, so nothing folds.
main! = |_args| {
	u8s : List(U8)
	u8s = [0, 1, 127, 128, 255]
	echo!("U8.to_i16 ${Str.inspect(u8s.map(|v| v.to_i16()))}")
	echo!("U8.to_i32 ${Str.inspect(u8s.map(|v| v.to_i32()))}")
	echo!("U8.to_i64 ${Str.inspect(u8s.map(|v| v.to_i64()))}")
	echo!("U8.to_i8_wrap ${Str.inspect(u8s.map(|v| v.to_i8_wrap()))}")
	echo!("U8.to_u16 ${Str.inspect(u8s.map(|v| v.to_u16()))}")
	echo!("U8.to_u32 ${Str.inspect(u8s.map(|v| v.to_u32()))}")
	echo!("U8.to_u64 ${Str.inspect(u8s.map(|v| v.to_u64()))}")
	echo!("U8.to_u8 ${Str.inspect(u8s.map(|v| v.to_u8()))}")
	echo!("U8.to_u8_wrap ${Str.inspect(u8s.map(|v| v.to_u8_wrap()))}")
	i8s : List(I8)
	i8s = [-128, -1, 0, 1, 127]
	echo!("I8.to_i16 ${Str.inspect(i8s.map(|v| v.to_i16()))}")
	echo!("I8.to_i32 ${Str.inspect(i8s.map(|v| v.to_i32()))}")
	echo!("I8.to_i64 ${Str.inspect(i8s.map(|v| v.to_i64()))}")
	echo!("I8.to_i8 ${Str.inspect(i8s.map(|v| v.to_i8()))}")
	echo!("I8.to_i8_wrap ${Str.inspect(i8s.map(|v| v.to_i8_wrap()))}")
	echo!("I8.to_u16_wrap ${Str.inspect(i8s.map(|v| v.to_u16_wrap()))}")
	echo!("I8.to_u32_wrap ${Str.inspect(i8s.map(|v| v.to_u32_wrap()))}")
	echo!("I8.to_u64_wrap ${Str.inspect(i8s.map(|v| v.to_u64_wrap()))}")
	echo!("I8.to_u8_wrap ${Str.inspect(i8s.map(|v| v.to_u8_wrap()))}")
	u16s : List(U16)
	u16s = [0, 255, 256, 32767, 32768, 65535]
	echo!("U16.to_i16_wrap ${Str.inspect(u16s.map(|v| v.to_i16_wrap()))}")
	echo!("U16.to_i32 ${Str.inspect(u16s.map(|v| v.to_i32()))}")
	echo!("U16.to_i64 ${Str.inspect(u16s.map(|v| v.to_i64()))}")
	echo!("U16.to_i8_wrap ${Str.inspect(u16s.map(|v| v.to_i8_wrap()))}")
	echo!("U16.to_u16 ${Str.inspect(u16s.map(|v| v.to_u16()))}")
	echo!("U16.to_u16_wrap ${Str.inspect(u16s.map(|v| v.to_u16_wrap()))}")
	echo!("U16.to_u32 ${Str.inspect(u16s.map(|v| v.to_u32()))}")
	echo!("U16.to_u64 ${Str.inspect(u16s.map(|v| v.to_u64()))}")
	echo!("U16.to_u8_wrap ${Str.inspect(u16s.map(|v| v.to_u8_wrap()))}")
	i16s : List(I16)
	i16s = [-32768, -129, -1, 0, 127, 128, 32767]
	echo!("I16.to_i16 ${Str.inspect(i16s.map(|v| v.to_i16()))}")
	echo!("I16.to_i16_wrap ${Str.inspect(i16s.map(|v| v.to_i16_wrap()))}")
	echo!("I16.to_i32 ${Str.inspect(i16s.map(|v| v.to_i32()))}")
	echo!("I16.to_i64 ${Str.inspect(i16s.map(|v| v.to_i64()))}")
	echo!("I16.to_i8_wrap ${Str.inspect(i16s.map(|v| v.to_i8_wrap()))}")
	echo!("I16.to_u16_wrap ${Str.inspect(i16s.map(|v| v.to_u16_wrap()))}")
	echo!("I16.to_u32_wrap ${Str.inspect(i16s.map(|v| v.to_u32_wrap()))}")
	echo!("I16.to_u64_wrap ${Str.inspect(i16s.map(|v| v.to_u64_wrap()))}")
	echo!("I16.to_u8_wrap ${Str.inspect(i16s.map(|v| v.to_u8_wrap()))}")
	u32s : List(U32)
	u32s = [0, 255, 65535, 65536, 2147483647, 2147483648, 4294967295]
	echo!("U32.to_i16_wrap ${Str.inspect(u32s.map(|v| v.to_i16_wrap()))}")
	echo!("U32.to_i32_wrap ${Str.inspect(u32s.map(|v| v.to_i32_wrap()))}")
	echo!("U32.to_i64 ${Str.inspect(u32s.map(|v| v.to_i64()))}")
	echo!("U32.to_i8_wrap ${Str.inspect(u32s.map(|v| v.to_i8_wrap()))}")
	echo!("U32.to_u16_wrap ${Str.inspect(u32s.map(|v| v.to_u16_wrap()))}")
	echo!("U32.to_u32 ${Str.inspect(u32s.map(|v| v.to_u32()))}")
	echo!("U32.to_u32_wrap ${Str.inspect(u32s.map(|v| v.to_u32_wrap()))}")
	echo!("U32.to_u64 ${Str.inspect(u32s.map(|v| v.to_u64()))}")
	echo!("U32.to_u8_wrap ${Str.inspect(u32s.map(|v| v.to_u8_wrap()))}")
	i32s : List(I32)
	i32s = [-2147483648, -65537, -1, 0, 65536, 2147483647]
	echo!("I32.to_i16_wrap ${Str.inspect(i32s.map(|v| v.to_i16_wrap()))}")
	echo!("I32.to_i32 ${Str.inspect(i32s.map(|v| v.to_i32()))}")
	echo!("I32.to_i32_wrap ${Str.inspect(i32s.map(|v| v.to_i32_wrap()))}")
	echo!("I32.to_i64 ${Str.inspect(i32s.map(|v| v.to_i64()))}")
	echo!("I32.to_i8_wrap ${Str.inspect(i32s.map(|v| v.to_i8_wrap()))}")
	echo!("I32.to_u16_wrap ${Str.inspect(i32s.map(|v| v.to_u16_wrap()))}")
	echo!("I32.to_u32_wrap ${Str.inspect(i32s.map(|v| v.to_u32_wrap()))}")
	echo!("I32.to_u64_wrap ${Str.inspect(i32s.map(|v| v.to_u64_wrap()))}")
	echo!("I32.to_u8_wrap ${Str.inspect(i32s.map(|v| v.to_u8_wrap()))}")
	u64s : List(U64)
	u64s = [0, 4294967295, 4294967296, 9007199254740991, 9007199254740992, 9007199254740993, 9223372036854775807, 9223372036854775808, 18446744073709551615]
	echo!("U64.to_i16_wrap ${Str.inspect(u64s.map(|v| v.to_i16_wrap()))}")
	echo!("U64.to_i32_wrap ${Str.inspect(u64s.map(|v| v.to_i32_wrap()))}")
	echo!("U64.to_i64_wrap ${Str.inspect(u64s.map(|v| v.to_i64_wrap()))}")
	echo!("U64.to_i8_wrap ${Str.inspect(u64s.map(|v| v.to_i8_wrap()))}")
	echo!("U64.to_u16_wrap ${Str.inspect(u64s.map(|v| v.to_u16_wrap()))}")
	echo!("U64.to_u32_wrap ${Str.inspect(u64s.map(|v| v.to_u32_wrap()))}")
	echo!("U64.to_u64 ${Str.inspect(u64s.map(|v| v.to_u64()))}")
	echo!("U64.to_u64_wrap ${Str.inspect(u64s.map(|v| v.to_u64_wrap()))}")
	echo!("U64.to_u8_wrap ${Str.inspect(u64s.map(|v| v.to_u8_wrap()))}")
	i64s : List(I64)
	i64s = [-9223372036854775808, -9007199254740993, -9007199254740992, -4294967297, -1, 0, 9007199254740993, 9223372036854775807]
	echo!("I64.to_i16_wrap ${Str.inspect(i64s.map(|v| v.to_i16_wrap()))}")
	echo!("I64.to_i32_wrap ${Str.inspect(i64s.map(|v| v.to_i32_wrap()))}")
	echo!("I64.to_i64 ${Str.inspect(i64s.map(|v| v.to_i64()))}")
	echo!("I64.to_i64_wrap ${Str.inspect(i64s.map(|v| v.to_i64_wrap()))}")
	echo!("I64.to_i8_wrap ${Str.inspect(i64s.map(|v| v.to_i8_wrap()))}")
	echo!("I64.to_u16_wrap ${Str.inspect(i64s.map(|v| v.to_u16_wrap()))}")
	echo!("I64.to_u32_wrap ${Str.inspect(i64s.map(|v| v.to_u32_wrap()))}")
	echo!("I64.to_u64_wrap ${Str.inspect(i64s.map(|v| v.to_u64_wrap()))}")
	echo!("I64.to_u8_wrap ${Str.inspect(i64s.map(|v| v.to_u8_wrap()))}")
	Ok({})
}
