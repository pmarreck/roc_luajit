#!/usr/bin/env bash
# The fx host's command-line flags under LuaJIT agree with host.zig's: one fx
# app is built natively (--opt=dev, linked with host.zig, the oracle) and with
# --target=luajit, then both run with each argument list below and their exit
# status, stdout and stderr are compared. The lists cover the host self-test
# flags (--host-test-stack-overflow, --host-test-division-by-zero), which
# host.zig records while reading arguments and triggers after the loop, so an
# unknown flag anywhere still wins and the later self-test flag is the one run.
#
# Usage: fx_host_flags [ROC]
set -u

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$here/../.." && pwd)"
native_roc="${ROC_LUAJIT_NATIVE_ROC:-$root/zig-out/bin/roc-native}"
roc="${1:-$root/zig-out/bin/roc}"
app="test/fx/app.roc"
spec='1>Hello, world!'

work="$(mktemp -d "${TMPDIR:-/tmp}/fx_host_flags.XXXXXX")"
trap 'rm -rf "$work"' EXIT

(cd "$root" && "$native_roc" build --opt=dev --no-cache "$app" --output="$work/native" >"$work/nb" 2>&1) ||
	{ echo "fx_host_flags: native build failed"; cat "$work/nb"; exit 1; }
(cd "$root" && "$roc" build --target=luajit --no-cache "$app" --output="$work/app.lua" >"$work/lb" 2>&1) ||
	{ echo "fx_host_flags: LuaJIT build failed"; cat "$work/lb"; exit 1; }

cases=(
	"--host-test-stack-overflow"
	"--host-test-division-by-zero"
	"--host-test-stack-overflow --host-test-division-by-zero"
	"--host-test-division-by-zero --host-test-stack-overflow"
	"--host-test-stack-overflow --bogus"
	"--bogus --host-test-division-by-zero"
	"--test SPEC --host-test-division-by-zero"
	"--host-test-stack-overflow --test SPEC"
	"--bogus"
)

failures=0
for c in "${cases[@]}"; do
	# Each case is a space-separated argument list; the word SPEC stands for
	# $spec, which itself contains a space.
	read -r -a words <<<"$c"
	argv=()
	for w in "${words[@]}"; do
		if [ "$w" = SPEC ]; then argv+=("$spec"); else argv+=("$w"); fi
	done
	(cd "$work" && ./native "${argv[@]}" </dev/null >n.out 2>n.err); nrc=$?
	(cd "$work" && luajit ./app.lua "${argv[@]}" </dev/null >l.out 2>l.err); lrc=$?
	if [ "$nrc" -eq "$lrc" ] && cmp -s "$work/n.out" "$work/l.out" && cmp -s "$work/n.err" "$work/l.err"; then
		continue
	fi
	failures=$((failures + 1))
	printf '  diverged [%s]: exit native=%d luajit=%d\n' "$c" "$nrc" "$lrc"
	printf '    native stderr: %q\n    luajit stderr: %q\n' "$(cat "$work/n.err")" "$(cat "$work/l.err")"
done
echo "fx_host_flags: $((${#cases[@]} - failures)) agreed, $failures diverged"
exit "$failures"
