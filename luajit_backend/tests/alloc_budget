#!/usr/bin/env bash
# Allocation budgets: bytes the LuaJIT build of a benchmark program allocates
# per operation, measured with the garbage collector stopped (so the count is
# exact and independent of machine load). A budget catches a change that makes
# hot paths allocate more, which shows up as GC time long before a stopwatch
# notices it. Each line of BUDGETS is: program, argument count, operations
# performed at that argument count, ceiling in bytes per operation.
#
# Usage: alloc_budget [ROC]
set -u

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$here/../.." && pwd)"
roc="${1:-$root/zig-out/bin/roc}"

# dict_ops: 5000 * args inserts plus as many lookups.
# dec_math: 10000 * args iterations of a Dec multiply, divide and add.
# list_ops: 50000 * args elements collected, mapped, filtered and folded.
BUDGETS="
dict_ops 4 40000 600
dec_math 4 40000 1600
list_ops 4 200000 125
"

work="$(mktemp -d "${TMPDIR:-/tmp}/alloc_budget.XXXXXX")"
trap 'rm -rf "$work"' EXIT

cat >"$work/measure.lua" <<'EOF'
-- measure.lua APP OPS ARGS...: run APP with the GC stopped and print the
-- bytes allocated per operation when it exits.
local app, ops = arg[1], tonumber(arg[2])
local args = {}
for i = 3, #arg do args[#args + 1] = arg[i] end
collectgarbage("collect")
collectgarbage("stop")
local before = collectgarbage("count")
local real_exit = os.exit
os.exit = function(...)
	io.stderr:write(("%d\n"):format(math.floor((collectgarbage("count") - before) * 1024 / ops)))
	return real_exit(...)
end
arg = { [0] = app, unpack(args) }
dofile(app)
os.exit(0)
EOF

failures=0
while read -r name argc ops ceiling; do
	[ -n "$name" ] || continue
	if ! "$roc" build --target=luajit --no-cache "$root/luajit_backend/bench/$name.roc" --output="$work/$name.lua" >"$work/$name.build" 2>&1; then
		echo "  $name: LuaJIT build failed"
		cat "$work/$name.build"
		failures=$((failures + 1))
		continue
	fi
	args=()
	for ((i = 0; i < argc; i++)); do args+=(x); done
	per_op="$(cd "$work" && luajit measure.lua "$work/$name.lua" "$ops" "${args[@]}" 2>&1 >/dev/null | tail -1)"
	if [ "$per_op" -le "$ceiling" ] 2>/dev/null; then
		echo "  $name: $per_op bytes per operation (budget $ceiling)"
	else
		echo "  $name: $per_op bytes per operation exceeds the budget of $ceiling"
		failures=$((failures + 1))
	fi
done <<<"$BUDGETS"
echo "alloc_budget: $failures over budget"
exit "$failures"
