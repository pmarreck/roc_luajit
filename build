#!/usr/bin/env bash
# Build the downstream CLI and its own test tools in the pinned development shell.
set -eu
root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
steps=(roc -Doptimize=ReleaseFast)
dry_run=0
extra=()
while [ $# -gt 0 ]; do
    case "$1" in
        --debug) steps=(roc -Doptimize=Debug) ;;
        --test) steps=(roc test build-test-luajit-differential native) ;;
        --dry-run) dry_run=1 ;;
        --) shift; extra=("$@"); break ;;
        -h|--help) echo 'Usage: ./build [--debug|--test] [--dry-run] [-- extra zig build args]'; exit 0 ;;
        *) echo "Unknown option: $1" >&2; exit 2 ;;
    esac
    shift
done
cd "$root"
command=(nix develop -c zig build "${steps[@]}" -j2 ${extra[@]+"${extra[@]}"})
if [ "$dry_run" -eq 1 ]; then printf '%q ' "${command[@]}"; printf '\n'; else exec "${command[@]}"; fi
