#!/usr/bin/env bash
# ./bm: fixed-workload CPU and wall time of each benchmark program
# (luajit_backend/bench/*.roc) and startup-to-ready, checked by
# performance-profile against this project's approved external history. Cases
# are in profiling.json; the adapter is luajit_backend/bench/profile/run.
# Extra arguments go to performance-profile (for example --case NAME).
# Comparison with native Roc and other runtimes: luajit_backend/bench/compare/run.
# Instruction counts and peak RSS of one command: luajit_backend/bench/measure.
# Run inside the dev shell: nix develop -c ./bm
# History goes to $PERFORMANCE_HISTORY_URL (default
# file://$HOME/.local/state/performance-history).
exec "$(dirname "${BASH_SOURCE[0]}")/luajit_backend/bench/profile/engine" run --mode bm "$@"
